# ── LLM Provider ──────────────────────────────────────────────────────────────
# Troque as três variáveis abaixo para usar qualquer provedor.
#
# DeepSeek (barato, recomendado):
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#
# OpenAI:
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# Groq (grátis com limites generosos):
#   LLM_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Ollama (local, totalmente gratuito):
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
#
# Anthropic (via compatibilidade OpenAI):
#   LLM_API_KEY=sk-ant-...
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_MODEL=claude-opus-4-7
# ──────────────────────────────────────────────────────────────────────────────
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

JAVA_API_URL=http://localhost:8080
SCRAPER_API_KEY=studgrasp-scraper-dev-key-change-in-production
DB_URL=postgresql://studgrasp:studgrasp@localhost:5432/studgrasp
REDIS_URL=redis://localhost:6379